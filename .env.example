# Docker Compose reads .env from the project root. Never commit real secrets.
# Generate a secret with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# Keep true behind your production HTTPS reverse proxy.
# Set false only for local HTTP development.
COOKIE_SECURE=true

# Empty is correct when frontend and API share one origin.
ALLOWED_ORIGINS=

# Published address/port on the Docker host, not the container's listen address.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3001
