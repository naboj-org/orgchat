# Export these variables in your shell; the server does not load .env files.
HOST=127.0.0.1
PORT=3001
REDIS_URL=redis://127.0.0.1:6379/0
STATIC_DIR=../frontend/dist

# Replace with at least 32 random bytes, shared only with the JWT issuer.
JWT_SECRET=replace-this-with-a-long-random-secret
# Optional; when set, matching claims are required.
JWT_ISSUER=
JWT_AUDIENCE=

# Keep true in production. Set false only for local HTTP development.
COOKIE_SECURE=true
# Comma-separated exact frontend origins. Vite's proxy needs this in development.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
